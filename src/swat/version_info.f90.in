! Generated by CMake (configure_file) into the build folder: version, compiler and
! build date of this executable.
!   swatmf_version: the information only (used by the --version option)
!   swatmf_banner:  the same, plus the "reading file.cio" line, at the start of each run
subroutine swatmf_version
  implicit none
  write (*,'(a)') ''
  write (*,'(a)') '               SWAT2012  Rev. 636_smrt'
  write (*,'(a)') '      Soil & Water Assessment Tool + MODFLOW-NWT + RT3D'
  write (*,'(a)') ''
  write (*,'(a)') '      SWAT-MODFLOW3 @SWAT_VERSION@'
  write (*,'(a)') '      @CMAKE_Fortran_COMPILER_ID@ @CMAKE_Fortran_COMPILER_VERSION@, @CMAKE_BUILD_TYPE@, @CMAKE_HOST_SYSTEM_NAME@'
  write (*,'(a)') '      built @ISO@'
  write (*,'(a)') ''
end subroutine swatmf_version

subroutine swatmf_banner
  implicit none
  call swatmf_version
  write (*,'(a)') ' Program reading from file.cio . . . executing'
  write (*,'(a)') ''
end subroutine swatmf_banner
